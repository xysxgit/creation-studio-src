{
  "name": "creation-studio",
  "private": true,
  "version": "1.50.34",
  "description": "创作助手 · 剧本工坊 —— 画板式剧本创作工具（小说/轻小说/RPG/Galgame/影视），支持思维导图连线与局域网协同",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "preview": "vite preview",
    "lan": "node lan-url.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "node scripts/bump-version.mjs && npm run android:sync && cd android && ./gradlew assembleDebug && mkdir -p ../apk-dist && cp app/build/outputs/apk/debug/app-debug.apk ../apk-dist/creation-studio.apk",
    "test:smoke": "node tests/smoke.mjs",
    "test:stress": "node tests/stress.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write src server tests",
    "format:check": "prettier --check src server tests",
    "ship": "npm run typecheck && npm run test:stress && npm run build",
    "ship:full": "npm run ship && npm run android:apk",
    "test:culling": "node tests/culling.mjs",
    "test:ux": "node tests/ux-fixes.mjs",
    "test:ux2": "node tests/ux-fixes2.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/screen-orientation": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@tiptap/extension-color": "^2.6.6",
    "@tiptap/extension-highlight": "^2.6.6",
    "@tiptap/extension-image": "^2.6.6",
    "@tiptap/extension-link": "^2.6.6",
    "@tiptap/extension-placeholder": "^2.6.6",
    "@tiptap/extension-table": "^2.6.6",
    "@tiptap/extension-table-cell": "^2.6.6",
    "@tiptap/extension-table-header": "^2.6.6",
    "@tiptap/extension-table-row": "^2.6.6",
    "@tiptap/extension-text-align": "^2.6.6",
    "@tiptap/extension-text-style": "^2.6.6",
    "@tiptap/extension-underline": "^2.6.6",
    "@tiptap/html": "^2.6.6",
    "@tiptap/pm": "^2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "express": "^4.19.2",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~5.5.4",
    "vite": "^5.4.2"
  }
}